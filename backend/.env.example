# ──────────────────────────────────────────────────────────────────
# Project Nature — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ──────────────────────────────────────────────────────────────────

# Required in all environments
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# comma-separated origins for production (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# django admin path (default: admin/)
ADMIN_URL=admin/

# Database — defaults to SQLite if unset; set for Postgres in production
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Optional: error reporting (production)
# DJANGO_ADMINS=Admin Name,admin@example.com
# SERVER_EMAIL=noreply@project-nature.local
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=production

# ──────────────────────────────────────────────────────────────────
# MEDIA STORAGE (S3-compatible: AWS S3 / Cloudflare R2 / Backblaze B2)
# ──────────────────────────────────────────────────────────────────
# Only needed when USE_S3=true. When false (the default), media is stored
# on the LOCAL filesystem so local development requires no bucket credentials.
# Use S3-compatible object storage in production so uploaded media
# (expedition images + inquiry selfies) survives redeploys — Railway's
# container disk is ephemeral and is wiped on every deploy.
USE_S3=false

# AWS / R2 / B2 credentials
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# Endpoint override — REQUIRED for Cloudflare R2 / Backblaze B2
# (they are S3-compatible but not AWS). Leave blank for real AWS S3.
# e.g. R2: https://<account_id>.r2.cloudflarestorage.com
#      B2: https://s3.<region>.backblazeb2.com
AWS_S3_ENDPOINT_URL=

# Region. For R2 use "auto". For AWS S3 use the bucket region.
AWS_S3_REGION_NAME=auto

# Public/CDN hostname in front of the bucket (optional). If set, media URLs
# point here instead of the endpoint. Leave blank to use the endpoint URL.
AWS_S3_CUSTOM_DOMAIN=

# ACL policy for uploaded objects:
#   - None (recommended for personal data like selfies) => objects are PRIVATE.
#     Media is then served via SIGNED URLs that expire (see next two vars).
#   - public-read => objects are publicly reachable via their URL (needed only
#     if you want plain, non-signed public URLs and are OK with selfies being
#     downloadable by anyone who knows the URL).
AWS_DEFAULT_ACL=None

# When AWS_DEFAULT_ACL=None, URLs are signed. Keep this true for selfies.
AWS_QUERYSTRING_AUTH=true
# Signed URL lifetime in seconds (default 86400 = 24h).
AWS_QUERYSTRING_EXPIRE=86400
